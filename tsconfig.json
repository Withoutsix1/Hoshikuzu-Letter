{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": false,
    "types": [],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": true,
    "rootDir": "src/ui-primitives",
    "outDir": "dist/ui-primitives",
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/ui-primitives/**/*.ts",
    "src/ui-primitives/**/*.tsx"
  ]
}
